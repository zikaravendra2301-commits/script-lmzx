local function getPlayerLevel()
    local stats = lp:FindFirstChild("Data") or lp:FindFirstChild("leaderstats")
    if stats then
        local lvl = stats:FindFirstChild("Level") or stats:FindFirstChild("Lvl")
        if lvl then return lvl.Value end
    end
    -- fallback scan
    for _, v in ipairs(lp:GetDescendants()) do
        if (v.Name == "Level" or v.Name == "Lvl") and v:IsA("IntValue") then
            return v.Value
        end
    end
    return 1
end

local function getBestZone()
    local lvl = getPlayerLevel()
    local best = MOB_ZONES[1]
    for _, zone in ipairs(MOB_ZONES) do
        if lvl >= zone.minLvl and lvl <= zone.maxLvl then
            best = zone
            break
        end
    end
    return best
end

