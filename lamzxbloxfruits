-- SMART FARM
-- ============================================

local function getClosestMobInZone(zonePos, radius)
    local closest, minDist = nil, radius or 300
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if obj ~= char and obj.Humanoid.Health > 0 then
                local distFromZone = (obj.HumanoidRootPart.Position - zonePos).Magnitude
                if distFromZone < minDist then
                    minDist = distFromZone
                    closest = obj
                end
            end
        end
    end
    return closest
end

local statusLbl

local function autoFarmLoop()
    while STATE.AutoFarm do
        local zone = getBestZone()
        local lvl  = getPlayerLevel()

        if statusLbl then
            statusLbl.Text = "Farm: " .. zone.zone .. " (Lvl " .. lvl .. ")"
        end

        local mob = getClosestMobInZone(zone.pos, 400)

        if mob and mob:FindFirstChild("HumanoidRootPart") then
            -- TP ke mob
            hrp.CFrame = mob.HumanoidRootPart.CFrame + Vector3.new(0, 4, 4)
            task.wait(0.08)

            -- Attack via tool
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Handle") then
                pcall(function() tool:Activate() end)
            end

            -- Fire attack remotes
            for _, v in ipairs(game:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    local n = v.Name:lower()
                    if n:find("attack") or n:find("damage") or n:find("hit") then
                        pcall(function() v:FireServer(mob, mob:FindFirstChild("HumanoidRootPart")) end)
                    end
                end
            end
        else
            -- Zona kosong, tp ke zona
            hrp.CFrame = CFrame.new(zone.pos + Vector3.new(0, 5, 0))
        end

        task.wait(0.05)
    end
    if statusLbl then statusLbl.Text = "Farm: OFF" end
end

-- ============================================
-- TRADE FREEZE EXPLOIT
-- ============================================

--[[
    Cara kerja:
    1. Masuk trade session sama target
    2. Aktifin Trade Freeze
    3. Script nge-hook trade confirm remote
    4. Pas lawan add fruit & confirm,
       script intercept cancel dari lawan
       dan langsung fire confirm dari sisi kita
       sebelum server process cancel mereka
]]

local tradeFreezeActive = false
local tradeHook = nil
local tradeLbl

local function enableTradeFreeze()
    tradeFreezeActive = true
    if tradeLbl then tradeLbl.Text = "Trade Freeze: ACTIVE — waiting trade..." end

    pcall(function()
        local mt  = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args   = {...}

            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = (self.Name or ""):lower()

                -- Freeze: block cancel/decline dari lawan
                if remoteName:find("trade") then
                    if args[1] and type(args[1]) == "string" then
                        local a = args[1]:lower()
                        -- jangan block confirm kita, block cancel lawan
                        if a:find("cancel") or a:find("decline") or a:find("reject") then
                            if tradeFreezeActive then
                                -- drop cancel → lawan gak bisa cancel
                                return nil
                            end
                        end
                    end

                    -- Auto confirm dari sisi kita
                    if remoteName:find("confirm") or remoteName:find("accept") then
                        -- fire dulu sebelum lanjut normal
                        task.spawn(function()
                            task.wait(0.05)
                            pcall(function() self:FireServer(unpack(args)) end)
                        end)
                    end
                end
            end

            return old(self, ...)
        end)

        setreadonly(mt, true)
        tradeHook = mt.__namecall
    end)
end

local function disableTradeFreeze()
    tradeFreezeActive = false
    if tradeLbl then tradeLbl.Text = "Trade Freeze: OFF" end
    -- restore metatable namecall ke default susah di-restore,
    -- rejoin recommended setelah pakai fitur ini
end

