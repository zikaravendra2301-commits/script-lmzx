-- Toggle builder
local function makeToggle(parent, yPos, labelText, colorOn, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size             = UDim2.new(0.88, 0, 0, 38)
    btn.Position         = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
    btn.TextColor3       = Color3.fromRGB(100, 100, 130)
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 12
    btn.Text             = labelText .. "  [ OFF ]"
    btn.BorderSizePixel  = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text             = labelText .. "  [ ON ]"
            btn.BackgroundColor3 = colorOn
            btn.TextColor3       = Color3.new(1,1,1)
        else
            btn.Text             = labelText .. "  [ OFF ]"
            btn.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
            btn.TextColor3       = Color3.fromRGB(100, 100, 130)
        end
        callback(active)
    end)
    return btn
end

