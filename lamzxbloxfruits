local function makeToggle(parent, yPos, labelOff, labelOn, colorOn, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size             = UDim2.new(0.88, 0, 0, 38)
    btn.Position         = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    btn.TextColor3       = Color3.fromRGB(148, 163, 184)
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 12
    btn.Text             = labelOff .. "  [ OFF ]"
    btn.BorderSizePixel  = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text             = labelOn .. "  [ ON ]"
            btn.BackgroundColor3 = colorOn
            btn.TextColor3       = Color3.new(1,1,1)
        else
            btn.Text             = labelOff .. "  [ OFF ]"
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
            btn.TextColor3       = Color3.fromRGB(148, 163, 184)
        end
        callback(active)
    end)
    return btn
end

makeToggle(frame, 46,  "AUTO FARM",    "AUTO FARM",    Color3.fromRGB(34,197,94),   function(on) STATE.AutoFarm    = on; if on then task.spawn(autoFarmLoop)    end end)
